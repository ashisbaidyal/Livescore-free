<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>GOALSTREAM | KINETIC BROADCAST</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100;300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-primary": "#690003",
                        "tertiary-fixed-dim": "#c3c6cf",
                        "on-primary-fixed-variant": "#930006",
                        "secondary-container": "#1fa64a",
                        "on-secondary-fixed-variant": "#00531f",
                        "surface-container-low": "#1c1b1b",
                        "tertiary": "#c3c6cf",
                        "on-tertiary-container": "#e3e6ef",
                        "inverse-primary": "#bf050e",
                        "secondary": "#62df7b",
                        "inverse-surface": "#e5e2e1",
                        "surface": "#131313",
                        "on-secondary-fixed": "#002108",
                        "tertiary-container": "#63676f",
                        "on-background": "#e5e2e1",
                        "on-primary-container": "#ffdfda",
                        "background": "#131313",
                        "outline-variant": "#5d3f3c",
                        "tertiary-fixed": "#dfe2eb",
                        "on-tertiary": "#2d3137",
                        "secondary-fixed-dim": "#62df7b",
                        "secondary-fixed": "#80fc94",
                        "surface-dim": "#131313",
                        "surface-bright": "#3a3939",
                        "on-surface-variant": "#e6bdb7",
                        "error": "#ffb4ab",
                        "surface-container-highest": "#353534",
                        "primary": "#ffb4aa",
                        "on-tertiary-fixed-variant": "#43474e",
                        "inverse-on-surface": "#313030",
                        "primary-fixed-dim": "#ffb4aa",
                        "primary-container": "#cc1616",
                        "on-secondary": "#003913",
                        "on-error-container": "#ffdad6",
                        "primary-fixed": "#ffdad5",
                        "surface-container-lowest": "#0e0e0e",
                        "on-surface": "#e5e2e1",
                        "surface-container-high": "#2a2a2a",
                        "error-container": "#93000a",
                        "surface-tint": "#ffb4aa",
                        "on-error": "#690005",
                        "outline": "#ad8883",
                        "on-tertiary-fixed": "#181c22",
                        "on-secondary-container": "#00320f",
                        "surface-variant": "#353534",
                        "surface-container": "#201f1f",
                        "on-primary-fixed": "#410001"
                    },
                    fontFamily: {
                        "headline": ["Lexend"],
                        "body": ["Lexend"],
                        "label": ["Lexend"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-card {
            background: rgba(42, 42, 42, 0.6);
            backdrop-filter: blur(12px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }
        .tonal-transition {
            background: linear-gradient(to bottom, #131313, #1C1B1B);
        }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #0E0E0E; }
        ::-webkit-scrollbar-thumb { background: #CC1616; }
    </style>
</head>
<body class="bg-surface-container-lowest text-on-surface font-body overflow-x-hidden">
<!-- TopNavBar Shell -->
<nav class="fixed top-0 w-full z-50 border-b border-white/10 bg-[#131313]/80 backdrop-blur-xl shadow-[0_20px_40px_rgba(0,0,0,0.4)]">
<div class="flex justify-between items-center px-6 h-16 w-full max-w-[1920px] mx-auto">
<div class="text-2xl font-black italic tracking-tighter text-[#FFB4AA]">GOALSTREAM</div>
<div class="hidden md:flex gap-8 items-center font-['Lexend'] font-bold uppercase tracking-tighter">
<a class="text-[#FFB4AA] border-b-2 border-[#CC1616] pb-1 hover:opacity-100 transition-all duration-300" href="#">NBA</a>
<a class="text-[#E5E2E1] opacity-70 hover:text-[#FFB4AA] hover:opacity-100 transition-all duration-300" href="#">NFL</a>
