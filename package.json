{
  "name": "livescorefree-vanilla",
  "version": "1.0.0",
  "description": "Vanilla HTML/JS LiveScore Platform",
  "scripts": {
    "build": "tailwindcss -i ./css/input.css -o ./css/style.css --minify",
    "dev": "tailwindcss -i ./css/input.css -o ./css/style.css --watch",
    "deploy:cloudflare": "wrangler pages deploy . --project-name livescore-free",
    "deploy:cloudflare:branch": "wrangler pages deploy . --project-name livescore-free --branch main",
    "submit:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "tailwindcss": "^3.4.1"
  }
}
